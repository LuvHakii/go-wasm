-			msg := formatEvent(ev, lm)
-			trace.Log(ctx, "start", msg)
-		case event.IsLog(ev):
-			category := ""
-			if event.IsError(ev) {
-				category = "error"
-			}
-			msg := formatEvent(ev, lm)
-			trace.Log(ctx, category, msg)
-		case event.IsEnd(ev):
-			if v := ctx.Value(traceKey); v != nil {
-				v.(interface{ End() }).End()
-			}
-		}
-		return exporter(ctx, ev, lm)
-	}
-}
