-func (st *State) updateServer(server *Server) {
-	st.mu.Lock()
-	defer st.mu.Unlock()
-	for i, existing := range st.servers {
-		if existing.ID == server.ID {
-			// Replace, rather than mutate, to avoid a race.
-			newServers := make([]*Server, len(st.servers))
