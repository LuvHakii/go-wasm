-		var data any
-		if fun != nil {
-			data = fun(r)
-		}
-		if err := tmpl.Execute(w, data); err != nil {
-			event.Error(context.Background(), "", err)
-			http.Error(w, err.Error(), http.StatusInternalServerError)
-		}
-	}
-}
