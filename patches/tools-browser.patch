-		if !found {
-			return ctx // if this happens we are in a bad place
-		}
-		delete(t.unfinished, span.ID)
-		td.Finish = span.Finish().At()
-		td.Duration = span.Finish().At().Sub(span.Start().At())
-		td.Events = tdEvents
-		t.addRecentLocked(td, false) // add end event
